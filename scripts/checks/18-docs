#!/usr/bin/env bash
# Check after scripts: relative markdown links in docs/, README.md, AGENTS.md and skill/ must resolve, and every
# `shepherdr <verb>` instruction there must be a command help lists (audit 2026-11-18, QG-09). The logic and its
# fixture tests live in the docs.ts module beside this shim; the runner runs whichever executable files it finds.
set -uo pipefail
root=${SHEPHERDR_CHECK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
cd "$root" || exit 1
exec bun "$root/scripts/checks/docs.ts"
