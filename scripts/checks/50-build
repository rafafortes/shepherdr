#!/usr/bin/env bash
# Check 5: the build. The note is its time and the first-load chunk's size (SHE-112 keeps an eye on both).
set -uo pipefail
root=${SHEPHERDR_CHECK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
cd "$root" || exit 1
# one build of this worktree at a time: a --quick run can run beside a full run of the same worktree (its own lock), and
# both write dist/, which vite empties first, so their builds and the checks over it never interleave (SHE-172). The
# lock file sits in this run's log folder: per worktree, never in the repo, and it goes when this step does.
build_lock=${SHEPHERDR_CHECK_LOGS:-$root/node_modules/.cache}/build.lock
if command -v flock >/dev/null 2>&1 && mkdir -p "$(dirname "$build_lock")" 2>/dev/null && exec 8>>"$build_lock"; then
  # say it when another run of this worktree is building: what it waits is part of this step's time, and the step's own
  # timeout is what ends a build that never comes back
  if ! flock -n 8; then
    echo 'waiting for another build of this worktree to finish'
    flock 8
  fi
fi
bun run build
code=$?
if [ "$code" -ne 0 ]; then exit "$code"; fi
shopt -s nullglob
mains=(dist/assets/index-*.js)
if [ ${#mains[@]} -eq 0 ]; then echo 'build: no main index chunk in dist/assets' >&2; exit 1; fi
# the first load is the entry plus whatever index.html modulepreloads (a shared chunk can be preloaded too)
first=("${mains[@]}")
for pre in $(grep -oE 'href="\./assets/[^"]+\.js"' dist/index.html | sed 's/^href="\.\///; s/"$//'); do first+=("dist/$pre"); done
# the heavy Settings page bodies must load on demand, not ride in the first load (SHE-112). Each marker is a string
# of its own page that survives minification; the first check is the one that holds the bundle-size gain.
for marker in 'Reading every level' 'Waiting now'; do
  for f in "${first[@]}"; do
    if grep -q "$marker" "$f"; then
      echo "build: a first-load chunk still holds a Settings page body ($marker in $f)" >&2
      exit 1
    fi
  done
  if ! grep -rq "$marker" dist/assets; then
    echo "build: the lazy Settings page body is missing ($marker)" >&2
    exit 1
  fi
done
for chunk in ModelsPage LimitsPage; do
  if ! compgen -G "dist/assets/${chunk}-*.js" >/dev/null; then
    echo "build: the lazy ${chunk} chunk is missing" >&2
    exit 1
  fi
done
size=$(wc -c <"${mains[0]}" | tr -d ' ')
# hold the gain of this finding (898 kB before, 678 kB after); the audit's bundle budget can set a tighter limit later
if [ "$size" -ge 800000 ]; then
  echo "build: the first-load chunk grew to $size B, past SHE-112's 800000 B limit" >&2
  exit 1
fi
printf '%s; main chunk %s B\n' "$(grep -oE 'built in [0-9.]+m?s' "${SHEPHERDR_CHECK_LOG:-/dev/null}" | tail -1)" "$size" >"${SHEPHERDR_CHECK_NOTE:-/dev/null}"
exit 0
