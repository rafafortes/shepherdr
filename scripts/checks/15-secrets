#!/usr/bin/env bash
# Check 1 after dependencies: gitleaks over the tree and its history. The logic and its fixture tests live in the
# secrets.ts module beside this shim; the runner runs whichever executable files it finds in scripts/checks/.
set -uo pipefail
root=${SHEPHERDR_CHECK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
cd "$root" || exit 1
exec bun "$root/scripts/checks/secrets.ts"
