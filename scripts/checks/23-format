#!/usr/bin/env bash
# Check after the lint one (audit 2026-11-18, QG-02): Biome's formatter, on the code files the diff from the default
# branch touches (scripts/checks/format.ts). The logic and its fixture tests live in the format.ts module beside this
# shim; the runner runs whichever executable files it finds.
set -uo pipefail
root=${SHEPHERDR_CHECK_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}
cd "$root" || exit 1
exec bun "$root/scripts/checks/format.ts"
